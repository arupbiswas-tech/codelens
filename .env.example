# Copy to .env (cp .env.example .env). Never commit .env.
# Compose builds DATABASE_URL for the app from the POSTGRES_* values, so you rarely need to set it.

POSTGRES_USER=codelens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codelens

LOG_LEVEL=INFO

# Needed for POST /ask (Groq, OpenAI-compatible API). Without a key the app still starts and
# can index repos; /ask answers 503. Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
